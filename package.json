{
  "name": "mockflow",
  "version": "0.1.0",
  "description": "Collaborative API mock server platform",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/api",
    "apps/dashboard"
  ],
  "scripts": {
    "dev:api": "cd apps/api && npm run dev",
    "dev:dashboard": "cd apps/dashboard && npm run dev",
    "dev": "concurrently npm:dev:api npm:dev:dashboard",
    "dev:mock": "concurrently npm:dev:api npm:dev:dashboard",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md}\"",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "prepare": "husky",
    "postinstall": "node scripts/check-overrides.mjs"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,md}": "prettier --write"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.0.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
