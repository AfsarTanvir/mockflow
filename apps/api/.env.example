# App. The HTTP server binds to PORT/HOST (Adonis defaults: 3333 / localhost).
# API_URL is the public origin of this API — it's written into exported
# OpenAPI/Postman files, so keep its port in step with PORT.
NODE_ENV=development
PORT=3333
HOST=localhost
APP_SECRET=change-me-to-a-long-random-string
API_URL=http://localhost:3333
# Dashboard origin, used in links inside emails.
APP_URL=http://localhost:3001

# Database (matches docker-compose.yml)
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=mockflow
DB_PASSWORD=secret
DB_DATABASE=mockflow

# Email (optional). With no transport configured, links are logged to the console.
# MAILTRAP_TOKEN=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Platform master-agency company slug; its active admin+ members become super-admins.
# Leave unset to disable the /api/admin console.
MASTER_COMPANY_SLUG=
MASTER_COMPANY_MIN_ROLE=admin

# Redis cache. Without REDIS_HOST the app still runs — it just degrades to
# DB-only (no caching). CACHE_ENABLED=false is a global kill switch. TTLs in seconds.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=true
CACHE_TTL_MOCK=300
CACHE_TTL_ENTITY=600

# Scheduled mock calls via local-scheduler (optional). Unset SCHEDULER_URL = the
# "Schedule" option is shown disabled ("not configured"). SCHEDULER_API_KEY must match
# the scheduler's API_KEY. SCHEDULER_TARGET_URL is how the scheduler reaches this API
# (default API_URL); with the scheduler in Docker use http://host.docker.internal:3333.
SCHEDULER_URL=
SCHEDULER_API_KEY=
SCHEDULER_TARGET_URL=
