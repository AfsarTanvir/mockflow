# Loaded on top of .env whenever NODE_ENV=test (bin/test.ts sets it). Values here
# win; everything else (DB host/user/password, Redis, secrets) falls back to .env.
# Personal overrides go in .env.test.local (gitignored).
NODE_ENV=test

# Tests get their own database (created + migrated automatically before the
# integration suite) and their own cache namespace, so they never touch dev data.
DB_DATABASE=mockflow_test
CACHE_PREFIX=mockflow:test:cache:
